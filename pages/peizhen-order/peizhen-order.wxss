.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 180rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 80rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
}

.form-section {
  padding: 28rpx 32rpx;
}

.form-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.required {
  font-size: 30rpx;
  color: #E8852E;
  margin-left: 8rpx;
}

.label-optional {
  font-size: 26rpx;
  color: #999999;
  margin-left: 12rpx;
}

/* 服务类型横向滚动 */
.type-scroll {
  width: 100%;
  white-space: nowrap;
}

.type-chips {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 6rpx;
}

.type-chip {
  flex-shrink: 0;
  border: 2rpx solid #dddddd;
  border-radius: 32rpx;
  padding: 14rpx 28rpx;
  font-size: 30rpx;
  color: #555555;
  background-color: #ffffff;
}

.type-chip.on {
  background-color: #2D7D46;
  border-color: #2D7D46;
  color: #ffffff;
  font-weight: bold;
}

/* 服务类型价格联动提示 */
.type-price-hint {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

.type-price-amount {
  margin-left: 8rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #E8852E;
}

/* 选择行 */
.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.form-picker.half {
  flex: 1;
  min-width: 0;
}

.form-picker.locked {
  background-color: #E8F5E9;
}

.hospital-row {
  display: flex;
  gap: 16rpx;
}

.picker-value {
  font-size: 32rpx;
  color: #333333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-value:empty {
  color: #999999;
}

.picker-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

/* 帮办事项多选 */
.task-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.task-chip {
  border: 2rpx solid #dddddd;
  border-radius: 16rpx;
  padding: 16rpx 28rpx;
  font-size: 30rpx;
  color: #555555;
  background-color: #ffffff;
}

.task-chip.on {
  background-color: #2D7D46;
  border-color: #2D7D46;
  color: #ffffff;
  font-weight: bold;
}

/* 谁就诊 */
.who-row {
  display: flex;
  gap: 16rpx;
}

.who-btn {
  flex: 1;
  text-align: center;
  border: 2rpx solid #dddddd;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #555555;
  background-color: #ffffff;
}

.who-btn.on {
  background-color: #2D7D46;
  border-color: #2D7D46;
  color: #ffffff;
  font-weight: bold;
}

.family-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.family-col {
  flex: 1;
  min-width: 0;
}

.family-input {
  width: 100%;
  height: 88rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #333333;
  box-sizing: border-box;
}

/* 健康评估块 */
.assessment-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.assessment-badge {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: bold;
  color: #2D7D46;
  background-color: #E8F5E9;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.assessment-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

.assessment-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

/* 参考价格 */
.price-row {
  display: flex;
  align-items: baseline;
}

.price-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #E8852E;
}

.price-note {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

/* 图片上传 */
.image-upload {
  display: flex;
  flex-direction: column;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 16rpx;
}

.upload-btn {
  width: 180rpx;
  height: 180rpx;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  border: 2rpx dashed #DDDDDD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 48rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999999;
}

/* 补充说明 */
.form-textarea {
  width: 100%;
  height: 180rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
}

/* 底部提交栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #F0F0F0;
  z-index: 100;
}

.publish-btn {
  width: 100%;
  background-color: #2D7D46;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 44rpx;
  padding: 20rpx 0;
  text-align: center;
}

.publish-sub {
  display: block;
  font-size: 22rpx;
  font-weight: normal;
  opacity: 0.85;
  margin-top: 4rpx;
}

/* 定位选点行 */
.location-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.location-icon {
  font-size: 32rpx;
}

.location-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #666666;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.location-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

/* 表单校验错误高亮 */
.error-border {
  border: 2rpx solid #FF4D4F;
  box-sizing: border-box;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF4D4F;
}

/* 服务类型 chips 容器报错时的红色描边 */
.type-scroll.error-border {
  border-radius: 12rpx;
  padding: 4rpx;
}
