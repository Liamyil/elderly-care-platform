<view class="page-container">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <text class="nav-title">我的订单</text>
  </view>

  <view class="nav-content">
    <view class="status-tabs">
      <view 
        wx:for="{{statusTabs}}" 
        wx:key="key"
        class="status-tab {{currentStatus === item.key ? 'active' : ''}}"
        bindtap="onStatusTabClick"
        data-status="{{item.key}}"
        data-index="{{index}}"
      >
        <text class="tab-text">{{item.label}}</text>
        <text class="tab-badge">{{tabCounts[index]}}</text>
      </view>
    </view>

    <swiper 
      class="order-swiper" 
      current="{{currentIndex}}" 
      bindchange="onSwiperChange"
      duration="300"
    >
      <swiper-item wx:for="{{statusTabs}}" wx:key="key" class="swiper-item">
        <scroll-view scroll-y class="order-list" show-scrollbar="{{false}}">
          <view 
            wx:for="{{orders[item.key]}}" 
            wx:for-item="order"
            wx:key="id"
            class="order-card"
          >
            <view class="order-header">
              <text class="order-no">订单号：{{order.id}}</text>
              <text class="order-status {{order.statusKey}}">{{order.statusKey === 'pending_confirm' ? '服务完成·待确认' : order.status}}</text>
            </view>

            <view class="order-body">
              <view class="order-info-row">
                <text class="order-type">{{order.type}}</text>
                <text class="order-reward">{{order.priceText ? ('¥' + order.priceText) : ('🪙 ' + order.reward + '时间币')}}</text>
              </view>

              <view wx:if="{{order.statusKey === 'pending' && order.publishTime}}" class="order-publish-time-row">
                <text class="publish-time-label">发布时间：</text>
                <text class="publish-time">{{order.publishTime}}</text>
              </view>

              <view class="order-address-row">
                <text class="address-label">地址：</text>
                <text class="order-address">{{order.address}}</text>
              </view>

              <view class="order-time-row">
                <text class="time-label">预约时间：</text>
                <text class="order-time">{{order.time}}</text>
              </view>

              <view wx:if="{{order.remark}}" class="order-remark-row">
                <text class="remark-label">需求描述：</text>
                <text class="order-remark">{{order.remark}}</text>
              </view>

              <view wx:if="{{order.images}}" class="order-images-row">
                <text class="images-label">现场图片：</text>
                <text class="view-images-link" catchtap="onViewImages" data-order-id="{{order.id}}">点击查看图片</text>
              </view>

              <view wx:if="{{order.statusKey === 'cancelled' && order.cancelReason}}" class="cancel-reason-row">
                <text class="cancel-reason-label">取消原因：</text>
                <text class="cancel-reason-text">{{order.cancelReason}}</text>
              </view>

              <view wx:if="{{order.statusKey === 'pending' || order.statusKey === 'dispatch_pool'}}" class="auto-assign-hint">
                <text class="assign-icon">📌</text>
                <text class="assign-text">{{order.statusKey === 'dispatch_pool' ? '订单已超时无人接单，等待社区管理员指派互助员' : '如无人接单，订单将转入待派单池由社区管理员指派'}}</text>
              </view>
            </view>

            <view class="order-footer">
              <block wx:if="{{order.statusKey === 'reviewing'}}">
                <button class="btn btn-gray" catchtap="onCancelOrder" data-id="{{order.id}}">取消订单</button>
                <button class="btn btn-disabled" disabled>等待社区审核中...</button>
              </block>

              <block wx:if="{{order.statusKey === 'pending'}}">
                <button class="btn btn-gray" catchtap="onCancelOrder" data-id="{{order.id}}">取消订单</button>
                <button class="btn btn-disabled" disabled>等待接单中...</button>
              </block>

              <block wx:if="{{order.statusKey === 'dispatch_pool'}}">
                <button class="btn btn-gray" catchtap="onCancelOrder" data-id="{{order.id}}">取消订单</button>
                <button class="btn btn-disabled" disabled>等待管理员指派...</button>
              </block>

              <block wx:if="{{order.statusKey === 'serving'}}">
                <block wx:if="{{order.isHelper}}">
                  <view class="order-footer-info">
                    <text class="helper-info">我已接单</text>
                  </view>
                  <button class="btn btn-gray" catchtap="onContactHelper" data-id="{{order.id}}">联系TA</button>
                  <button class="btn btn-green" catchtap="onCompleteService" data-id="{{order.id}}">服务完成</button>
                </block>
                <block wx:else>
                  <!-- 同一底色块：左=互助员详情，右=联系TA（状态实时刷新，确认完成按钮只在待确认状态出现） -->
                  <view class="helper-detail-row">
                    <button class="btn helper-btn-left" catchtap="goHelperDetail" data-helper="{{order.helper}}">{{order.helper}} 详情</button>
                    <button class="btn helper-contact-btn" catchtap="onContactHelper" data-id="{{order.id}}">联系TA</button>
                  </view>
                  <!-- 取消订单 -->
                  <button class="btn btn-orange" catchtap="onCancelOrder" data-id="{{order.id}}">取消订单</button>
                </block>
              </block>

              <block wx:if="{{order.statusKey === 'pending_confirm'}}">
                <view class="order-footer-info">
                  <block wx:if="{{order.isHelper}}">
                    <text class="helper-info">已完成服务，等待确认</text>
                  </block>
                  <block wx:else>
                    <text class="helper-info">互助员：{{order.helper}}</text>
                    <text wx:if="{{order.extraReward > 0}}" class="extra-reward-info">已添加 +{{order.extraReward}}时间币</text>
                  </block>
                </view>
                <block wx:if="{{order.isHelper}}">
                  <button class="btn btn-disabled" disabled>等待确认中...</button>
                </block>
                <block wx:else>
                  <button class="btn btn-gray" catchtap="onContactHelper" data-id="{{order.id}}">联系TA</button>
                  <button class="btn btn-orange" catchtap="onAddReward" data-id="{{order.id}}">添加时间币</button>
                  <button class="btn btn-green" catchtap="onConfirmComplete" data-id="{{order.id}}">确认完成</button>
                </block>
              </block>

              <block wx:if="{{order.statusKey === 'completed'}}">
                <text class="completed-text">已完成</text>
                <button wx:if="{{!order.evaluated}}" class="btn btn-orange" catchtap="onGoReview" data-id="{{order.id}}">去评价</button>
                <text wx:else class="evaluated-text">已评价</text>
              </block>

              <block wx:if="{{order.statusKey === 'cancelled'}}">
                <view class="cancelled-row">
                  <view class="cancelled-times">
                    <view wx:if="{{order.publishTime}}" class="time-item">
                      <text class="time-item-label">发布：</text>
                      <text class="time-item-value">{{order.publishTime}}</text>
                    </view>
                    <view wx:if="{{order.cancelTime}}" class="time-item">
                      <text class="time-item-label">取消：</text>
                      <text class="time-item-value">{{order.cancelTime}}</text>
                    </view>
                  </view>
                  <text class="delete-btn" catchtap="onDeleteOrder" data-id="{{order.id}}">删除</text>
                </view>
              </block>
            </view>
          </view>

          <view wx:if="{{!orders[item.key] || orders[item.key].length === 0}}" class="empty-state">
            <text class="empty-icon">📋</text>
            <text class="empty-text">暂无{{item.label}}订单</text>
          </view>
        </scroll-view>
      </swiper-item>
    </swiper>

    <view wx:if="{{showCancelModal}}" class="modal-overlay" bindtap="onCloseCancelModal">
      <view class="modal-content" catchtap="preventClose">
        <view class="modal-header">
          <text class="modal-title">取消订单</text>
          <view class="modal-close" bindtap="onCloseCancelModal">
            <text class="close-icon">×</text>
          </view>
        </view>
        <view class="modal-body">
          <text class="modal-desc">请选择取消原因：</text>
          <view class="reason-options">
            <view 
              wx:for="{{cancelReasons}}" 
              wx:key="value"
              class="reason-option {{selectedReason === item.value ? 'selected' : ''}}"
              bindtap="onSelectReason"
              data-value="{{item.value}}"
            >
              <view class="reason-radio">
                <view wx:if="{{selectedReason === item.value}}" class="radio-inner"></view>
              </view>
              <text class="reason-text">{{item.label}}</text>
            </view>
          </view>
        </view>
        <view class="modal-footer">
          <button class="btn btn-gray btn-full" bindtap="onCloseCancelModal">取消</button>
          <button 
            class="btn btn-orange btn-full {{selectedReason ? '' : 'btn-disabled'}}" 
            bindtap="onConfirmCancel"
            disabled="{{!selectedReason}}"
          >确认取消</button>
        </view>
      </view>
    </view>

    <view wx:if="{{showImageModal}}" class="modal-overlay image-modal-overlay" bindtap="onCloseImageModal">
      <view class="image-modal-content" catchtap="preventClose">
        <view class="modal-header">
          <text class="modal-title">订单现场图片</text>
          <view class="modal-close" bindtap="onCloseImageModal">
            <text class="close-icon">×</text>
          </view>
        </view>
        <scroll-view scroll-x class="image-scroll" show-scrollbar="false">
          <view class="image-preview-list">
            <view wx:for="{{previewImages}}" wx:key="index" class="preview-item">
              <image 
                src="{{item}}" 
                mode="aspectFill"
                class="preview-image"
                bindtap="onPreviewImage"
                binderror="onImageError"
                data-index="{{index}}"
              />
            </view>
          </view>
        </scroll-view>
        <view class="image-tip">点击图片可放大查看</view>
      </view>
    </view>

    <view wx:if="{{showRewardModal}}" class="modal-overlay" bindtap="onCloseRewardModal">
      <view class="modal-content" catchtap="preventClose">
        <view class="modal-header">
          <text class="modal-title">添加时间币</text>
          <view class="modal-close" bindtap="onCloseRewardModal">
            <text class="close-icon">×</text>
          </view>
        </view>
        <view class="modal-body">
          <view class="reward-current-row">
            <text class="reward-current-label">原服务时间币：</text>
            <text class="reward-current-value">{{rewardModalBase}}</text>
          </view>
          <view wx:if="{{rewardModalExtra > 0}}" class="reward-current-row">
            <text class="reward-current-label">已添加时间币：</text>
            <text class="reward-current-value reward-extra-value">+{{rewardModalExtra}}</text>
          </view>
          <view class="reward-input-row">
            <text class="reward-input-label">追加数量：</text>
            <input 
              class="reward-input" 
              type="number" 
              value="{{rewardModalInput}}" 
              bindinput="onRewardInput" 
              placeholder="请输入追加的时间币数量"
              focus="{{showRewardModal}}"
            />
          </view>
          <view class="reward-total-row">
            <text class="reward-total-label">总时间币：</text>
            <text class="reward-total-value">{{rewardModalTotal}}</text>
          </view>
          <view class="reward-tip">提示：确认后将自动从您的账户扣除时间币并转给互助员</view>
        </view>
        <view class="modal-footer">
          <button class="btn btn-gray btn-full" bindtap="onCloseRewardModal">取消</button>
          <button 
            class="btn btn-orange btn-full {{rewardModalInput > 0 ? '' : 'btn-disabled'}}" 
            bindtap="onConfirmAddReward"
            disabled="{{rewardModalInput <= 0}}"
          >确认添加</button>
        </view>
      </view>
    </view>
  </view>
  <login-popup show="{{showLogin}}" bind:success="onLoginSuccess" bind:close="onLoginClose" />
</view>
