.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 120rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 80rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
}

.profile-section {
  background: linear-gradient(180deg, #2D7D46 0%, #3A8F58 100%);
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 0 0 32rpx 32rpx;
}

.profile-info {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 24rpx;
}

.avatar {
  width: 100%;
  height: 100%;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-detail {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.risk-tag {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.risk-tag.low-risk {
  background-color: rgba(76, 175, 80, 0.3);
  color: #81C784;
}

.risk-tag.medium-risk {
  background-color: rgba(232, 133, 46, 0.3);
  color: #FFB74D;
}

.risk-tag.high-risk {
  background-color: rgba(244, 67, 54, 0.3);
  color: #EF5350;
}

.section {
  margin: 28rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.section-more {
  font-size: 26rpx;
  color: #999999;
}

.metrics-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.metric-card {
  width: calc(50% - 10rpx);
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.metric-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.metric-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.metric-label {
  font-size: 24rpx;
  color: #999999;
}

.medicine-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.medicine-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F7F8FA;
}

.medicine-item:last-child {
  border-bottom: none;
}

.medicine-info {
  flex: 1;
}

.medicine-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.medicine-dosage {
  font-size: 26rpx;
  color: #666666;
  display: block;
  margin-bottom: 4rpx;
}

.medicine-time {
  font-size: 24rpx;
  color: #999999;
}

.medicine-status {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.medicine-status.taken {
  background-color: #EBF5F0;
  color: #2D7D46;
}

.medicine-status.not-taken {
  background-color: #FFF3E0;
  color: #E8852E;
}

.record-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F7F8FA;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  align-items: center;
}

.record-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-type {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 6rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999999;
}

.record-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #2D7D46;
}