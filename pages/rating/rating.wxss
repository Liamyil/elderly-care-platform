.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 120rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 80rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 28rpx 32rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.order-count {
  font-size: 26rpx;
  color: #999999;
}

.order-list {
  padding: 0 32rpx;
}

.order-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  margin-bottom: 20rpx;
}

.order-left-bar {
  width: 6rpx;
  background-color: #2D7D46;
  border-radius: 16rpx 0 0 16rpx;
}

.order-content {
  flex: 1;
  padding: 28rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-type {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.order-time {
  font-size: 24rpx;
  color: #BBBBBB;
}

.order-helper {
  margin-bottom: 12rpx;
}

.helper-label {
  font-size: 26rpx;
  color: #999999;
}

.helper-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
}

.order-address {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.address-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.address-text {
  font-size: 26rpx;
  color: #666666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-reward {
  font-size: 26rpx;
  color: #E8852E;
}

.rating-btn {
  background-color: #E8852E;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 16rpx 36rpx;
  border-radius: 30rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
}

.rating-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.rating-modal-content {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.rating-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.rating-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.rating-modal-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-text {
  font-size: 40rpx;
  color: #999999;
}

.rating-modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.rating-section {
  margin-bottom: 32rpx;
}

.rating-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 20rpx;
}

.star-rating {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.star {
  font-size: 72rpx;
  color: #DDDDDD;
  line-height: 1;
}

.star.active {
  color: #FFB300;
}

.rating-hint {
  text-align: center;
  font-size: 26rpx;
  color: #999999;
  margin-top: 16rpx;
  display: block;
}

.tags-section {
  margin-bottom: 32rpx;
}

.tags-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 20rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 16rpx 32rpx;
  background-color: #F7F8FA;
  color: #666666;
  font-size: 28rpx;
  border-radius: 30rpx;
}

.tag.selected {
  background-color: #EBF5F0;
  color: #2D7D46;
  font-weight: bold;
}

.input-section {
  margin-bottom: 20rpx;
}

.input-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.rating-input {
  width: 100%;
  height: 200rpx;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.rating-modal-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0F0F0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #2D7D46;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
}