.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 80rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
} 

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
}

/* 分类 Tab（固定于导航下方） */
.message-tabs {
  position: fixed;
  top: 160rpx;
  left: 0;
  right: 0;
  display: flex;
  background-color: #ffffff;
  border-bottom: 1rpx solid #EEEEEE;
  z-index: 998;
}

.message-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666666;
  position: relative;
}

.message-tab.active {
  color: #2D7D46;
  font-weight: bold;
}

.message-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: #2D7D46;
}

.message-list {
  padding: 24rpx;
  padding-top: 128rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s;
}

.message-item.unread {
  background-color: #F8FCF9;
  border-left: 6rpx solid #2D7D46;
}

.message-item.read {
  opacity: 0.7;
}

.message-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.message-icon-wrapper.order {
  background-color: #EBF5F0;
}

.message-icon {
  font-size: 40rpx;
}

.message-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.message-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.message-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: bold;
}

.message-item.read .message-title {
  color: #999999;
  font-weight: normal;
}

.message-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.message-item.read .message-desc {
  color: #999999;
}

.message-time {
  font-size: 22rpx;
  color: #BBBBBB;
}

/* 带订单号的消息显示跳转提示 */
.message-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.message-jump {
  font-size: 22rpx;
  color: #2D7D46;
}

.message-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #FF4D4F;
  flex-shrink: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #BBBBBB;
}
