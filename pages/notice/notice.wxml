<view class="page-container">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-left" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
    </view>
    <text class="nav-title">消息中心</text>
    <view class="nav-right"></view>
  </view>

  <view class="nav-content">
    <!-- 分类 Tab：全部 / 订单动态 -->
    <view class="message-tabs">
      <view class="message-tab {{activeTab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="switchTab">全部</view>
      <view class="message-tab {{activeTab === 'order' ? 'active' : ''}}" data-tab="order" bindtap="switchTab">订单动态</view>
    </view>

    <view class="message-list">
      <view
        wx:for="{{filteredMessages}}"
        wx:key="id"
        class="message-item {{item.isRead ? 'read' : 'unread'}}"
        bindtap="onMessageClick"
        data-id="{{item.id}}"
      >
        <view class="message-icon-wrapper order">
          <text class="message-icon">📋</text>
        </view>
        <view class="message-content">
          <view class="message-title-row">
            <text class="message-title">{{item.title}}</text>
            <view wx:if="{{!item.isRead}}" class="message-dot"></view>
          </view>
          <text class="message-desc">{{item.content}}</text>
          <view class="message-bottom-row">
            <text class="message-time">{{item.time}}</text>
            <text wx:if="{{item.orderId}}" class="message-jump">查看订单 ›</text>
          </view>
        </view>
      </view>

      <view wx:if="{{filteredMessages.length === 0}}" class="empty-state">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无消息</text>
        <text class="empty-hint">订单状态变更时将在此处显示</text>
      </view>
    </view>
  </view>
</view>

<global-toast id="globalToast" />
