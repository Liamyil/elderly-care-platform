.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 80rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 40rpx;
}

/* 区块 */
.section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.section-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}

/* 基本信息：左 40% 头像（左对齐），右 60% 昵称/手机号 */
.profile-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.avatar-half {
  width: 40%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
}

/* 头像框：严格 1:1 正方形容器（宽高同值），圆角虚线画在 view 上 */
.avatar-frame {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 26rpx;
  border: 2rpx dashed #2D7D46;
  background-color: #F2F8F4;
  overflow: hidden;
  flex-shrink: 0;
}

/* 图片：绝对定位平铺框内，等比例缩放居中完整显示，不截断 */
.avatar-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* 按钮：透明覆盖在图片之上，仅承载选择头像交互 */
.avatar-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  box-sizing: border-box;
}

.avatar-btn::after {
  border: none;
}

.avatar-placeholder {
  font-size: 48rpx;
  color: #2D7D46;
}

/* 右半：昵称/手机号，文本自适应不溢出 */
.info-half {
  width: 60%;
  flex-shrink: 0;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.info-label {
  width: 88rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #999999;
  text-align: right;
}

.info-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 64rpx;
  background-color: #F7F8FA;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #333333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.save-btn {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #2D7D46 0%, #4CAF50 100%);
  border-radius: 44rpx;
  padding: 20rpx 0;
  text-align: center;
}

.save-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

/* 角色 */
.role-row {
  display: flex;
  gap: 20rpx;
}

.role-chip {
  flex: 1;
  border: 3rpx solid #E5E5E5;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.role-chip.on {
  border-color: #2D7D46;
  background-color: #E8F5E9;
}

.role-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
}

.role-desc {
  font-size: 24rpx;
  color: #666666;
}

/* 微信绑定 */
.bind-done {
  background-color: #E8F5E9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.bind-done-text {
  font-size: 28rpx;
  color: #2D7D46;
  line-height: 1.5;
}

.bind-todo {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bind-todo-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

.bind-btn {
  border: 2rpx solid #07C160;
  border-radius: 44rpx;
  padding: 20rpx 0;
  text-align: center;
}

.bind-btn-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #07C160;
}
