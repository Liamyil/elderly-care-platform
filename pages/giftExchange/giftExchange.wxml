<view class="page-container">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-left" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
    </view>
    <text class="nav-title">实物兑换</text>
    <view class="nav-right"></view>
  </view>

  <view class="nav-content">
    <view class="balance-card">
      <text class="balance-label">当前时间币余额</text>
      <view class="balance-value">
        <text class="balance-num">{{timeCoins}}</text>
        <text class="balance-unit">时间币</text>
      </view>
    </view>

    <view class="section-header">
      <text class="section-title">可兑换商品</text>
    </view>

    <view class="gift-list">
      <view 
        wx:for="{{gifts}}" 
        wx:key="id" 
        class="gift-item"
      >
        <view class="gift-image">
          <text class="gift-emoji">{{item.emoji}}</text>
        </view>
        <view class="gift-info">
          <text class="gift-name">{{item.name}}</text>
          <text class="gift-price">🪙 {{item.coins}}时间币</text>
        </view>
        <view 
          class="exchange-btn {{item.exchanged ? 'exchanged' : ''}}" 
          bindtap="onExchange" 
          data-id="{{item.id}}"
        >
          <text class="exchange-text">{{item.exchanged ? '已兑换' : '兑换'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

<global-toast id="globalToast" />
