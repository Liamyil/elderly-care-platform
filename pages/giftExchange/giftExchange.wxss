.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 56rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
}

.balance-card {
  background: linear-gradient(180deg, #2D7D46 0%, #1E5A32 100%);
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  text-align: center;
}

.balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 16rpx;
}

.balance-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.balance-num {
  font-size: 72rpx;
  font-weight: bold;
  color: #ffffff;
}

.balance-unit {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 8rpx;
}

.section-header {
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.gift-list {
  padding: 0 24rpx;
}

.gift-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.gift-image {
  width: 100rpx;
  height: 100rpx;
  background-color: #FFF8E1;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.gift-emoji {
  font-size: 56rpx;
}

.gift-info {
  flex: 1;
}

.gift-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}

.gift-price {
  font-size: 30rpx;
  color: #E8852E;
  font-weight: bold;
}

.exchange-btn {
  padding: 16rpx 40rpx;
  background-color: #2D7D46;
  border-radius: 12rpx;
}

.exchange-btn.exchanged {
  background-color: #F5F5F5;
}

.exchange-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
}

.exchange-btn.exchanged .exchange-text {
  color: #999999;
}