<view class="page-container">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-left" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
    </view>
    <text class="nav-title">个人信息</text>
    <view class="nav-right"></view>
  </view>

  <view class="nav-content">
    <view class="avatar-section">
      <!-- 圆形框画在 view 上，图片绝对定位平铺不变形；button 透明覆盖仅承载选择交互 -->
      <view class="avatar-wrapper">
        <image class="avatar" src="{{userInfo.avatar || '/images/我的页面/mi.png'}}" mode="aspectFill" />
        <button class="avatar-choose" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
        <view class="avatar-edit">
          <text class="edit-icon">✎</text>
        </view>
      </view>
      <text class="avatar-hint">点击更换头像</text>
    </view>

    <view class="info-list">
      <view class="info-item">
        <text class="info-label">姓名</text>
        <view class="info-right" bindtap="onNameClick">
          <text class="info-value">{{userInfo.name}}</text>
          <text class="info-arrow">›</text>
        </view>
      </view>

      <view class="info-item">
        <text class="info-label">手机号</text>
        <text class="info-value">{{userInfo.phone || '未绑定'}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">角色</text>
        <text class="info-value">{{userInfo.role}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">用户ID</text>
        <text class="info-value">{{userInfo.userId}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showNameModal}}" class="modal-overlay" bindtap="onCloseNameModal">
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">修改姓名</text>
        <view class="modal-close" bindtap="onCloseNameModal">
          <text class="close-icon">×</text>
        </view>
      </view>
      <view class="modal-body">
        <input 
          class="name-input" 
          placeholder="请输入新姓名" 
          value="{{editName}}" 
          bindinput="onNameInput"
          focus="{{showNameModal}}"
        />
      </view>
      <view class="modal-footer">
        <button class="btn btn-gray btn-full" bindtap="onCloseNameModal">取消</button>
        <button 
          class="btn btn-green btn-full {{editName.trim() ? '' : 'btn-disabled'}}" 
          bindtap="onSaveName"
          disabled="{{!editName.trim()}}"
        >保存</button>
      </view>
    </view>
  </view>
</view>

<global-toast id="globalToast" />
