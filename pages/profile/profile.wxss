.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 56rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
}

.avatar-section {
  background: linear-gradient(180deg, #2D7D46 0%, #1E5A32 100%);
  padding: 80rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  overflow: hidden;
}

.avatar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* 透明覆盖按钮：仅承载点击选择头像 */
.avatar-choose {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  box-sizing: border-box;
}

.avatar-choose::after {
  border: none;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  background-color: #E8852E;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
}

.edit-icon {
  font-size: 28rpx;
  color: #ffffff;
}

.avatar-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 20rpx;
}

.info-list {
  margin: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 30rpx;
  color: #666666;
}

.info-right {
  display: flex;
  align-items: center;
}

.info-value {
  font-size: 30rpx;
  color: #333333;
}

.info-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  margin-left: 16rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.name-input {
  height: 96rpx;
  font-size: 32rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #F0F0F0;
}

.btn {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  border-radius: 0;
}

.btn-gray {
  background-color: #F5F5F5;
  color: #666666;
}

.btn-green {
  background-color: #2D7D46;
  color: #ffffff;
}

.btn-disabled {
  opacity: 0.5;
}