.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 160rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 80rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
}

.form-section {
  padding: 28rpx 32rpx;
}

.form-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.required {
  font-size: 30rpx;
  color: #E8852E;
  margin-left: 8rpx;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.picker-value {
  font-size: 34rpx;
  color: #333333;
}

.picker-value:empty {
  color: #999999;
}

.picker-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

.form-input {
  height: 88rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #333333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #333333;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.image-upload {
  display: flex;
  flex-direction: column;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 16rpx;
}

.upload-btn {
  width: 180rpx;
  height: 180rpx;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  border: 2rpx dashed #DDDDDD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 48rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999999;
}

.upload-hint {
  font-size: 24rpx;
  color: #BBBBBB;
  margin-top: 16rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #F0F0F0;
}

.publish-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #2D7D46;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
}

/* 陪诊健康评估块 */
.assessment-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.assessment-badge {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: bold;
  color: #2D7D46;
  background-color: #E8F5E9;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.assessment-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

.assessment-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

/* 详情地址行：输入框 + 定位按钮 */
.address-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.address-input {
  flex: 1;
  min-width: 0;
}

.locate-btn {
  flex-shrink: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background-color: #E8F5E9;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #2D7D46;
  font-weight: bold;
}

/* 表单校验错误高亮 */
.error-border {
  border: 2rpx solid #FF4D4F;
  box-sizing: border-box;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF4D4F;
}