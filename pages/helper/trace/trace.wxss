.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 180rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 80rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 32rpx;
}

.form-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.required {
  font-size: 30rpx;
  color: #E8852E;
  margin-left: 8rpx;
}

.label-optional {
  font-size: 26rpx;
  color: #999999;
  margin-left: 12rpx;
}

/* 订单信息 */
.order-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-type {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.order-addr {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

/* 定位 */
.location-done {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background-color: #E8F5E9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.location-todo {
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.location-text {
  font-size: 30rpx;
  color: #333333;
}

.location-time {
  font-size: 24rpx;
  color: #999999;
}

.location-btn {
  text-align: center;
  border: 2rpx solid #2D7D46;
  color: #2D7D46;
  border-radius: 44rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  font-weight: bold;
}

/* 现场照片 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 16rpx;
}

.upload-btn {
  width: 180rpx;
  height: 180rpx;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  border: 2rpx dashed #DDDDDD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999999;
}

/* 说明卡 */
.tip-card {
  margin-top: 24rpx;
  background-color: #FFF7E6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #B26A00;
  line-height: 1.5;
}

/* 底部提交栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #F0F0F0;
  z-index: 100;
}

.submit-btn {
  width: 100%;
  background-color: #2D7D46;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 44rpx;
  padding: 24rpx 0;
  text-align: center;
}
