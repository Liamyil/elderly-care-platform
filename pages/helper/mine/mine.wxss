.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 120rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 16rpx;
  z-index: 999;
}

.nav-content {
  padding-top: 135rpx;
}

.nav-title {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: bold;
}

.profile-section {
  background: #2D7D46;
  padding: 30rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 0 0 32rpx 32rpx;
}

.profile-info {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 20rpx;
}

.avatar {
  width: 100%;
  height: 100%;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-detail {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.settings-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-icon {
  width: 55rpx;
  height: 55rpx;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background-color: #ffffff;
  margin: 20rpx 24rpx 20rpx;
  padding: 32rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 10;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 0 8rpx;
  min-width: 0;
}

.stat-value {
  font-size: 44rpx;
  color: #2D7D46;
  font-weight: bold;
  display: block;
  white-space: nowrap;
}

.stat-label {
  font-size: 22rpx;
  color: #666666;
  display: block;
  margin-top: 10rpx;
  white-space: nowrap;
}

.menu-list {
  background-color: #ffffff;
  margin: 0 24rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  height: 128rpx;
  padding: 0 32rpx;
  border-bottom: 3rpx solid #F7F8FA;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 60rpx;
  margin-right: 26rpx;
}

.menu-name {
  flex: 1;
  font-size: 36rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
}

.logout-section {
  padding: 0 24rpx;
}

.logout-btn {
  background-color: #ffffff;
  padding: 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  text-align: center;
}

.logout-text {
  font-size: 36rpx;
  color: #E8852E;
}

/* ===== 模式切换卡片（双重身份共存：统计卡与功能列表之间的高频切换入口，接单端浅绿） ===== */

.mode-switch-card {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 28rpx 30rpx;
  border-radius: 20rpx;
  background: #E8F7EC;
  border: 2rpx solid #95DEA4;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.mode-switch-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.mode-switch-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #2D7D46;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mode-switch-arrow {
  font-size: 36rpx;
  font-weight: bold;
  color: #7FB88A;
  margin-left: 12rpx;
  flex-shrink: 0;
}
