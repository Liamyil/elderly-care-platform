<view class="page-container">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <text class="nav-title">我的</text>
  </view>

  <view class="nav-content">
    <view class="profile-section">
      <view class="profile-info" bindtap="onProfileClick">
        <view class="avatar-wrapper">
          <image class="avatar" src="{{userInfo.avatar || '/images/我的页面/mi.png'}}" mode="aspectFill" />
        </view>
        <view class="user-info">
          <text class="user-name">{{userInfo.name}}</text>
          <text class="user-detail">手机号：{{userInfo.phone}} | {{userInfo.role}}</text>
        </view>
      </view>
      <view class="settings-btn" bindtap="goToSettings">
        <image class="settings-icon" src="/images/我的页面/sz.png" mode="aspectFit" />
      </view>
    </view>

    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-value">{{userInfo.timeCoins}}</text>
        <text class="stat-label">累计获得时间币</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{userInfo.rmbBalance}}</text>
        <text class="stat-label">人民币余额（元）</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{userInfo.serviceCount}}</text>
        <text class="stat-label">已完成订单</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{userInfo.evaluationScore}}</text>
        <text class="stat-label">服务评价</text>
      </view>
    </view>

    <!-- 模式切换卡片（双重身份共存）：统计卡与功能列表之间，整页为接单端语境 -->
    <view class="mode-switch-card" bindtap="onSwitchToUser">
      <text class="mode-switch-icon">🔄</text>
      <text class="mode-switch-text">当前模式：接单模式（点击切换至发单端）</text>
      <text class="mode-switch-arrow">></text>
    </view>

    <view class="menu-list">
      <view class="menu-item" bindtap="goToAccount">
        <text class="menu-icon">🔐</text>
        <text class="menu-name">账号与安全</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToOrderList">
        <text class="menu-icon">📋</text>
        <text class="menu-name">我的订单</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToBank">
        <text class="menu-icon">🏦</text>
        <text class="menu-name">时间银行</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToCredit">
        <text class="menu-icon">⭐</text>
        <text class="menu-name">信用积分</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToEvaluation">
        <text class="menu-icon">📝</text>
        <text class="menu-name">服务评价</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-name">关于平台</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="logout-section">
      <view class="logout-btn" bindtap="onLogout">
        <text class="logout-text">退出登录</text>
      </view>
    </view>
  </view>

  <nav-bar selected="3"></nav-bar>
  <login-popup show="{{showLogin}}" bind:success="onLoginSuccess" bind:close="onLoginClose" />
</view>
