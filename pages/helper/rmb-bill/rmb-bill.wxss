.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 120rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 56rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
}

/* ===== 余额汇总卡：与时间银行页同风格，收入绿 / 支出红 ===== */

.overview-card {
  margin: 32rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #2D7D46 0%, #4CAF50 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(45, 125, 70, 0.3);
}

.balance-section {
  text-align: center;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 16rpx;
}

.balance-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.balance-num {
  font-size: 96rpx;
  color: #ffffff;
  font-weight: bold;
  line-height: 1;
}

.balance-unit {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 12rpx;
}

.stats-row {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 32rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}

.stat-value.income {
  color: #A5D6A7;
}

.stat-value.expense {
  color: #FF8A80;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

/* ===== 流水列表：收入绿 + / 支出红 -，金额醒目 ===== */

.recent-section {
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
}

.section-more {
  font-size: 26rpx;
  color: #999999;
}

.transaction-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.transaction-item {
  display: flex;
  align-items: center;
  padding: 35rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.transaction-item:last-child {
  border-bottom: none;
}

.transaction-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.transaction-icon.income {
  background-color: #E8F7EC;
}

.transaction-icon.expense {
  background-color: #FDECEC;
}

.icon-text {
  font-size: 60rpx;
  font-weight: bold;
}

.transaction-icon.income .icon-text {
  color: #07C160;
}

.transaction-icon.expense .icon-text {
  color: #E64340;
}

.transaction-info {
  flex: 1;
  min-width: 0;
}

.transaction-name {
  font-size: 32rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.transaction-time {
  font-size: 28rpx;
  color: #999999;
  display: block;
}

.transaction-amount {
  font-size: 38rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.transaction-amount.income {
  color: #07C160;
}

.transaction-amount.expense {
  color: #E64340;
}

/* ===== 明细点击跳转订单：有关联订单的行加右侧箭头与按压反馈 ===== */

.transaction-arrow {
  font-size: 40rpx;
  color: #C0C0C0;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.transaction-item-hover {
  background-color: #F7F8FA;
}

.empty-state {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
