.page-container {
  height: 100vh;
  overflow: hidden;
  background-color: #F7F8FA;
  display: flex;
  flex-direction: column;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-title {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-content {
  padding-top: 180rpx;
  padding-bottom: 100rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.status-tabs {
  display: flex;
  background-color: #F7F8FA;
  padding: 20rpx;
  gap: 16rpx;
  flex-shrink: 0;
}

.status-tab {
  flex: 1;
  padding: 28rpx 16rpx;
  text-align: center;
  position: relative;
  border-radius: 16rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.status-tab.active {
  background-color: #E8F5EC;
  box-shadow: 0 4rpx 12rpx rgba(45, 125, 70, 0.1);
}

.status-tab.active .tab-text {
  color: #2D7D46;
  font-weight: bold;
}

.tab-text {
  font-size: 32rpx;
  color: #666666;
}

/* 状态数量（实时更新）：无底色橙色粗体数字 */
.tab-badge {
  font-size: 28rpx;
  font-weight: bold;
  color: #E8852E;
  margin-left: 6rpx;
  display: inline-block;
}

.order-swiper {
  flex: 1;
  height: 0;
}

.swiper-item {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

.order-list {
  flex: 1;
  height: 0;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
}

.order-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.order-no {
  font-size: 24rpx;
  color: #999999;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.order-status.serving {
  background-color: #EBF5F0;
  color: #2D7D46;
}

.order-status.pending_confirm {
  background-color: #FFF3E0;
  color: #E8852E;
}

.order-status.completed {
  background-color: #F5F5F5;
  color: #999999;
}

.order-status.cancelled {
  background-color: #F5F5F5;
  color: #BBBBBB;
}

.order-body {
  margin-bottom: 20rpx;
}

.order-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-type {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
}

.order-reward {
  font-size: 28rpx;
  color: #E8852E;
}

.order-address-row,
.order-time-row,
.cancel-reason-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.address-label,
.time-label,
.cancel-reason-label {
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.order-address,
.order-time,
.cancel-reason-text {
  font-size: 26rpx;
  color: #666666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 下单人姓名行（服务中/已完成卡片） */
.order-elder-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.elder-label {
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.elder-name {
  font-size: 26rpx;
  color: #2D7D46;
  font-weight: bold;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-remark-row,
.order-images-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.remark-label,
.images-label {
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.order-remark {
  font-size: 26rpx;
  color: #666666;
  flex: 1;
  line-height: 1.5;
}

.view-images-link {
  font-size: 26rpx;
  color: #2196F3;
  text-decoration: underline;
}

.order-footer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
  width: 100%;
  box-sizing: border-box;
}

.order-footer .btn {
  margin: 0;
  width: 100%;
  align-self: stretch;
  box-sizing: border-box;
}

.order-footer-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
}

.helper-info {
  font-size: 26rpx;
  color: #666666;
}

.btn {
  height: 68rpx;
  padding: 0 32rpx;
  border-radius: 34rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn::after {
  border: none;
}

.btn-gray {
  background-color: #F0F0F0;
  color: #666666;
}

.btn-disabled {
  background-color: #F5F5F5;
  color: #BBBBBB;
}

.btn-green {
  background-color: #2D7D46;
  color: #FFFFFF;
}

.completed-text {
  font-size: 26rpx;
  color: #999999;
}

.waiting-text {
  font-size: 26rpx;
  color: #E8852E;
}

.evaluated-text {
  font-size: 26rpx;
  color: #2D7D46;
}

.cancelled-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.cancelled-times {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.time-item {
  display: flex;
  align-items: center;
}

.time-item-label {
  font-size: 22rpx;
  color: #999999;
  margin-right: 4rpx;
}

.time-item-value {
  font-size: 22rpx;
  color: #666666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.image-modal-content {
  width: 100%;
  max-height: 58vh;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 28rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 34rpx;
  color: #333333;
  font-weight: bold;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 48rpx;
  color: #999999;
}

.image-scroll {
  flex: 1;
  width: 100%;
  white-space: nowrap;
  margin-top: 16rpx;
  overflow: hidden;
}

.image-preview-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 4rpx 20rpx;
}

.preview-item {
  flex-shrink: 0;
  width: 420rpx;
  height: 420rpx;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background-color: #f0f0f0;
}

.preview-image {
  width: 100%;
  height: 100%;
  display: block;
}

.image-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding-top: 12rpx;
  padding-bottom: 8rpx;
}

/* 服务留痕打卡栏（服务中订单）：两个小按钮并排 */
.trace-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.trace-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx solid #CCCCCC;
  border-radius: 32rpx;
  padding: 12rpx 0;
  background-color: #ffffff;
}

.trace-item.done {
  background-color: #E8F5E9;
  border-color: #2D7D46;
}

.trace-icon {
  font-size: 26rpx;
}

.trace-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
}

.trace-state {
  font-size: 22rpx;
  color: #2D7D46;
}
