.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 120rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-content {
  padding-top: 180rpx;
}

.nav-title {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: bold;
}

.overview-card {
  margin: 32rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #2D7D46 0%, #4CAF50 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(45, 125, 70, 0.3);
}

.balance-section {
  text-align: center;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
}

.balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 16rpx;
}

.balance-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.balance-num {
  font-size: 96rpx;
  color: #ffffff;
  font-weight: bold;
  line-height: 1;
}

.balance-unit {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 12rpx;
}

.stats-row {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 32rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: bold;
  display: block;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.function-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.function-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.function-icon {
  width: 48rpx;
  height: 48rpx;
}

.function-emoji {
  font-size: 48rpx;
}

.function-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.recent-section {
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
}

.section-more {
  font-size: 26rpx;
  color: #2D7D46;
}

.transaction-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.transaction-item {
  display: flex;
  align-items: center;
  padding: 35rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.transaction-item:last-child {
  border-bottom: none;
}

.transaction-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.transaction-icon.income {
  background-color: #EBF5F0;
}

.transaction-icon.expense {
  background-color: #FFF3E0;
}

.icon-text {
  font-size: 60rpx;
  font-weight: bold;
}

.transaction-icon.income .icon-text {
  color: #2D7D46;
}

.transaction-icon.expense .icon-text {
  color: #E8852E;
}

.transaction-info {
  flex: 1;
  min-width: 0;
}

.transaction-name {
  font-size: 32rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.transaction-time {
  font-size: 28rpx;
  color: #999999;
  display: block;
}

.transaction-amount {
  font-size: 38rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.transaction-amount.income {
  color: #2D7D46;
}

.transaction-amount.expense {
  color: #E8852E;
}