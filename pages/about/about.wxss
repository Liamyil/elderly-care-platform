.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 120rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 80rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  background-color: #ffffff;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  background-color: #EBF5F0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logo-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D7D46;
}

.platform-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.version-info {
  font-size: 26rpx;
  color: #999999;
}

.content-section {
  margin: 28rpx 32rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  text-align: justify;
}

.policy-list {
  display: flex;
  flex-direction: column;
}

.policy-item {
  display: flex;
  margin-bottom: 20rpx;
}

.policy-item:last-child {
  margin-bottom: 0;
}

.policy-num {
  font-size: 28rpx;
  color: #2D7D46;
  font-weight: bold;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.policy-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.contact-info {
  display: flex;
  flex-direction: column;
}

.contact-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.contact-item:last-child {
  margin-bottom: 0;
}

.contact-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.contact-text {
  font-size: 28rpx;
  color: #666666;
}

.copyright-section {
  display: flex;
  justify-content: center;
  padding: 40rpx 32rpx;
  margin-top: 20rpx;
}

.copyright-text {
  font-size: 24rpx;
  color: #999999;
}