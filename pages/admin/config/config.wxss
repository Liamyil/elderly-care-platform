.page-container {
  min-height: 100vh;
  background: #F7F8FA;
}

.custom-nav {
  background: #2D7D46;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 20rpx;
}

.nav-left,
.nav-right {
  width: 80rpx;
}

.nav-back-icon {
  color: #ffffff;
  font-size: 48rpx;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
}

.nav-content {
  padding: 24rpx;
}

.readonly-tip {
  background: #FFF7E6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.readonly-text {
  font-size: 24rpx;
  color: #D48806;
}

.seg-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.seg-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
}

.seg-tab.on {
  background: #2D7D46;
  color: #ffffff;
}

.config-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.config-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.config-info {
  display: flex;
  flex-direction: column;
}

.config-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.config-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.config-value {
  display: flex;
  align-items: baseline;
}

.config-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #2D7D46;
}

.config-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 6rpx;
}

.config-edit {
  margin-top: 16rpx;
  text-align: center;
  color: #2D7D46;
  border: 1rpx solid #2D7D46;
  border-radius: 32rpx;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.tip-card {
  background: #E8F7EC;
  border-radius: 12rpx;
  padding: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #2D7D46;
  line-height: 1.6;
}

.log-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.log-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.log-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #E8852E;
}

.log-time {
  font-size: 22rpx;
  color: #999;
}

.log-line {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
  word-break: break-all;
}

.log-remark {
  color: #CF1322;
}

.load-more {
  text-align: center;
  color: #2D7D46;
  font-size: 26rpx;
  padding: 20rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
