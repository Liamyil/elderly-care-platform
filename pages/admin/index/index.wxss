.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
}

.custom-nav {
  background-color: #2D7D46;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title {
  height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-logout {
  height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #ffffff;
  opacity: 0.9;
}

.nav-content {
  padding: 24rpx 32rpx;
}

.readonly-tip {
  background-color: #FFF7E6;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
}

.readonly-text {
  font-size: 26rpx;
  color: #B26A00;
  line-height: 1.5;
}

/* 统计卡 */
.stats-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx 0;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #2D7D46;
}

.stat-value.total {
  color: #E8852E;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

/* 菜单 */
.menu-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
}

.menu-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

/* 提示卡 */
.tip-card {
  margin-top: 24rpx;
  background-color: #E8F5E9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #2D7D46;
  line-height: 1.5;
}
