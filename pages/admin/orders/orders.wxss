.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #2D7D46;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 20rpx;
  z-index: 999;
}

.nav-left {
  width: 80rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 80rpx;
  color: #ffffff;
  line-height: 1;
}

.nav-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-right {
  width: 80rpx;
}

.nav-content {
  padding-top: 160rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 40rpx;
}

/* 页签 */
.tabs-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.tabs {
  display: inline-flex;
  gap: 16rpx;
}

.tab {
  flex-shrink: 0;
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
  color: #555555;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab.on {
  background-color: #2D7D46;
  color: #ffffff;
  font-weight: bold;
}

/* 订单卡 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.order-type {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.order-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #E8852E;
}

.order-line {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.order-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.btn {
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-green {
  background-color: #2D7D46;
  color: #ffffff;
}

.btn-orange {
  background-color: #E8852E;
  color: #ffffff;
}

.btn-gray {
  background-color: #F2F3F5;
  color: #555555;
}

.btn-red {
  background-color: #CF1322;
  color: #ffffff;
}

/* 超时订单标记（建议指派提醒） */
.assign-badge {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #B26A00;
  background-color: #FFF3D6;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 72rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 弹层 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}

.modal-sheet {
  width: 100%;
  max-height: 80vh;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #222222;
}

.modal-close {
  font-size: 36rpx;
  color: #999999;
  padding: 8rpx;
}

.helper-list {
  max-height: 60vh;
}

.helper-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.helper-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.helper-info {
  font-size: 24rpx;
  color: #999999;
}

.helper-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #999999;
}

/* 详情 */
.detail-body {
  max-height: 65vh;
}

.detail-line {
  display: block;
  font-size: 27rpx;
  color: #444444;
  line-height: 1.7;
}

.trace-block {
  margin-top: 20rpx;
  border-top: 2rpx solid #F0F0F0;
  padding-top: 16rpx;
}

.trace-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #2D7D46;
  margin-bottom: 12rpx;
}

.trace-item {
  border-left: 4rpx solid #2D7D46;
  padding-left: 16rpx;
  margin-bottom: 16rpx;
}

.trace-line {
  display: block;
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
}

.trace-photos {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.trace-photo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
  background-color: #F2F3F5;
}

/* 紧急干预弹层（高危操作） */
.force-body {
  max-height: 65vh;
}

.force-tip {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.force-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin: 16rpx 0 8rpx;
}

.helper-item.on {
  background-color: #E8F7EC;
  border-radius: 12rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.force-input {
  width: 100%;
  height: 140rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.force-confirm {
  margin-top: 24rpx;
  text-align: center;
  background-color: #CF1322;
  color: #ffffff;
  border-radius: 44rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: bold;
}

.force-warn {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #999999;
  margin-top: 16rpx;
}
