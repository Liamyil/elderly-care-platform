/* 组件宿主元素：开发者工具里自定义组件默认行内布局，显式设为块级避免错乱 */
:host {
  display: block;
  width: 100%;
}

.nav-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 100rpx;
  display: flex;
  background-color: #ffffff;
  border-top: 1rpx solid #EEEEEE;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  z-index: 999;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 不用 flex gap（开发者工具渲染内核不支持），用 margin 保持图标与文字间距 */
.nav-icon {
  margin-bottom: 6rpx;
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.nav-text {
  font-size: 22rpx;
  color: #999999;
  line-height: 1;
}

.nav-item.active .nav-text {
  color: #2D7D46;
  font-weight: 500;
}
