.login-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}

.login-sheet {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  position: relative;
  box-sizing: border-box;
}

.sheet-close {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 36rpx;
  color: #BBBBBB;
  padding: 8rpx;
}

.sheet-back {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.sheet-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #222222;
}

.sheet-sub {
  font-size: 26rpx;
  color: #999999;
  margin-top: 10rpx;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

/* 微信登录按钮 */
.btn-wechat {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background-color: #07C160;
  border-radius: 48rpx;
  padding: 26rpx 0;
}

.btn-wechat-icon {
  font-size: 40rpx;
}

.btn-wechat-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
}

/* 短信登录按钮 */
.btn-phone {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #07C160;
  border-radius: 48rpx;
  padding: 24rpx 0;
}

.btn-phone-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #07C160;
}

/* 协议行 */
.agreement-row {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.agree-check {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #CCCCCC;
  border-radius: 50%;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agree-check.on {
  background-color: #07C160;
  border-color: #07C160;
}

.agree-mark {
  font-size: 22rpx;
  color: #ffffff;
}

.agree-text {
  font-size: 24rpx;
  color: #999999;
}

.agree-link {
  font-size: 24rpx;
  color: #2D7D46;
}

/* 输入框 */
.input-box {
  background-color: #F7F8FA;
  border-radius: 14rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.sheet-input {
  height: 92rpx;
  font-size: 32rpx;
  color: #333333;
}

.input-code-row {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  background-color: #E8F5E9;
  border-radius: 10rpx;
}

.code-btn.disabled {
  opacity: 0.6;
}

.code-btn-text {
  font-size: 26rpx;
  color: #2D7D46;
  font-weight: bold;
}

/* 角色卡片 */
.role-card {
  border: 3rpx solid #E5E5E5;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.role-card.on {
  border-color: #2D7D46;
  background-color: #E8F5E9;
}

.role-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #222222;
}

.role-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}
